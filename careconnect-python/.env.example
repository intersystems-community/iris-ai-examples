# Copy to .env and fill in values before running docker compose up

# IRIS AI Hub image (EAP participants only — UNCOMMENT AND SET THIS)
# Without this set, the stack runs on the community image, which lacks iris_llm.
# Load your EAP tarball: docker load < irishealth-*.tar
# Then set the tag printed by docker load:
# IRIS_IMAGE=<registry>/intersystems/irishealth:2026.3.0AI.139.0

OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

IRIS_USERNAME=_SYSTEM
IRIS_PASSWORD=SYS
