zn "%SYS"
do ##class(Security.Services).Get("%Service_Bindings",.p)
set p("Enabled")=1
do ##class(Security.Services).Modify("%Service_Bindings",.p)
do ##class(Security.Users).UnExpireUserPasswords("_SYSTEM")
set sc = ##class(Security.Users).Get("_SYSTEM",.Props)
set Props("ChangePassword") = 0
set sc = ##class(Security.Users).Modify("_SYSTEM",.Props)

; This example's agent and tools are Python. The only ObjectScript here is the
; persistent class the Python tools read over SQL, plus its demo-data loader.
zn "USER"
do $system.OBJ.LoadDir("/src/CareConnect","ck",,1)
do ##class(CareConnect.Setup.DemoData).Load()
set rs = ##class(%SQL.Statement).%ExecDirect(,"SELECT COUNT(*) AS N FROM CareConnect.Patient")
do rs.%Next()
write "CareConnect demo patients loaded: ",rs.%Get("N"),!
halt
