# Copy to .env and fill in values before running docker compose up

# LLM — choose one
OPENAI_API_KEY=sk-...          # OpenAI
# OLLAMA_MODEL=llama3.2:3b    # Uncomment + use --profile ollama for local

# Any OpenAI-compatible endpoint. The agents resolve both of these through
# CareConnect.Agent.SDoHAssessment's PROVIDERCONFIG parameter; compose supplies the
# defaults below, so you only need these lines to point somewhere else.
#
# The trailing slash is load-bearing. AI-Core joins "chat/completions" onto this with
# URL-relative semantics, so ".../v1" resolves to ".../chat/completions" and the endpoint
# answers HTTP 500 with an empty body. ".../v1/" resolves correctly.
#
# Pick a model the endpoint actually serves — an unknown model name returns that same
# bodiless 500, as does a key the endpoint rejects. Three causes, one symptom naming none
# of them: ##class(CareConnect.Setup.LLMConfig).Probe() tells them apart.
#OPENAI_BASE_URL=https://api.openai.com/v1/
#OPENAI_MODEL=gpt-4o-mini

# IRIS AI Hub image (EAP participants only — UNCOMMENT AND SET THIS)
# Without this set, stack runs on community image which lacks %AI.* classes.
# Load your EAP tarball: docker load < irishealth-*.tar  (see docs/eap-setup.md)
# Then set the tag printed by docker load:
# IRIS_IMAGE=<registry>/intersystems/irishealth:2026.3.0AI.139.0
# The <registry> part comes from the tarball you loaded — docker load prints it.

# IVG knowledge graph (--profile ivg only)
IVG_API_KEY=changeme
