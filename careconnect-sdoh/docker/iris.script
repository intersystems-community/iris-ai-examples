zn "%SYS"
do ##class(Security.Services).Get("%Service_Bindings",.p)
set p("Enabled")=1
do ##class(Security.Services).Modify("%Service_Bindings",.p)
do ##class(Security.Users).UnExpireUserPasswords("_SYSTEM")
set sc = ##class(Security.Users).Get("_SYSTEM",.Props)
set Props("ChangePassword") = 0
set sc = ##class(Security.Users).Modify("_SYSTEM",.Props)

set props("NameSpace")          = "USER"
set props("DispatchClass")      = "CareConnect.MCP.Service"
set props("AutheEnabled")       = 96
set props("MatchRoles")         = ":%All"
set props("Recurse")            = 1
set props("Enabled")            = 1
do ##class(Security.Applications).Create("/mcp/careconnect", .props)

zn "USER"
do $system.OBJ.LoadDir("/src/CareConnect","k",,1)
do $system.OBJ.Compile("CareConnect.Patient","ck")
do $system.OBJ.Compile("CareConnect.Message.FollowUpRequest","ck")
do $system.OBJ.Compile("CareConnect.Message.FollowUpResponse","ck")
do $system.OBJ.Compile("CareConnect.Service.SDoHFollowUpBS","ck")
do $system.OBJ.Compile("CareConnect.Process.SDoHFollowUpBP","ck")
do $system.OBJ.Compile("CareConnect.Operation.SDoHFollowUpBO","ck")
do $system.OBJ.Compile("CareConnect.Production","ck")
do $system.OBJ.Compile("CareConnect.MCP.Service","ck")
do $system.OBJ.Compile("CareConnect.Tools.SDoHToolSet","ck")
do $system.OBJ.Compile("CareConnect.Setup.DemoData","ck")
do $system.OBJ.Compile("CareConnect.Setup.MCPSetup","ck")
do ##class(CareConnect.Setup.DemoData).Load()
do ##class(Ens.Director).StartProduction("CareConnect.Production")
set mgr = ##class(%AI.ToolMgr).GetOrCreate("/mcp/careconnect",.isNew)
do ##class(%AI.MCP.Service).LoadToolSetsToManager(mgr,"CareConnect.Tools.SDoHToolSet")
write "CareConnect ready. Tools: ",mgr.FindTools("").%Size(),!
halt
