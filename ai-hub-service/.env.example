# Copy to .env next to docker-compose.yml. Every value has a working default.

# API keys -> principals (see examples/careconnect/base.yaml). Change them for
# anything that is not a laptop.
AIHUB_KEY_CHW=dev-chw-key
AIHUB_KEY_LEAD=dev-lead-key
AIHUB_KEY_APP=dev-app-key
AIHUB_KEY_ADMIN=dev-admin-key

# The model behind the sdoh-assistant agent (the sdoh-assessment playbook needs none).
# AIHUB_LLM_ENGINE=openai          # openai | anthropic
# AIHUB_LLM_MODEL=gpt-4o-mini
# AIHUB_LLM_BASE_URL=              # any OpenAI-compatible endpoint; blank = provider default
# AIHUB_LLM_API_KEY=

# Liquid d1 decision model used by sdoh-decision-gate. The mock mode is keyless;
# switch to liquid and provide a key from https://console.liquid.ai.
# LIQUID_DECISION_MODE=mock       # mock | liquid
# LIQUID_DECISION_MODEL=d1:free
# LIQUID_BASE_URL=https://api.liquid.ai
# LIQUID_API_KEY=liquid_...

# Host ports
# AIHUB_PORT=8080
# LEGACY_SUPERSERVER_PORT=41972
# LEGACY_WEB_PORT=41773
# COMPANION_SUPERSERVER_PORT=41973

# Sidecar profile. The legacy instance is a tag of irishealth-community that
# predates AI Hub; the companion needs an AI Hub build (see
# ../careconnect-sdoh/docs/eap-setup.md).
# LEGACY_IRIS_VERSION=2025.3
# IRIS_IMAGE=<registry>/intersystems/irishealth:<ai-tag>
