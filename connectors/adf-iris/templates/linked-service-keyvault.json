{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "Azure Key Vault linked service. Required so the IRIS ODBC linked service's password (and the sink storage connection string) can be AzureKeyVaultSecret references instead of inline SecureString/plaintext. Deploy this before linked-service-iris-odbc.json."
  },
  "parameters": {
    "factoryName": { "type": "string" },
    "keyVaultLinkedServiceName": { "type": "string", "defaultValue": "AzureKeyVaultLinkedService" },
    "keyVaultBaseUrl": {
      "type": "string",
      "metadata": { "description": "e.g. https://kv-iris-adf.vault.azure.net/" }
    }
  },
  "resources": [
    {
      "type": "Microsoft.DataFactory/factories/linkedservices",
      "apiVersion": "2018-06-01",
      "name": "[concat(parameters('factoryName'), '/', parameters('keyVaultLinkedServiceName'))]",
      "properties": {
        "type": "AzureKeyVault",
        "typeProperties": {
          "baseUrl": "[parameters('keyVaultBaseUrl')]"
        }
      }
    }
  ],
  "outputs": {
    "keyVaultLinkedServiceName": {
      "type": "string",
      "value": "[parameters('keyVaultLinkedServiceName')]"
    }
  }
}
