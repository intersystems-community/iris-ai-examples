<?xml version='1.0' encoding='utf-8' ?>
<!--
  Schema: validation/tdr_latest.xsd in tableau/connector-plugin-sdk — see
  STATUS.md for the real xmllint validation output. Structure copied from
  samples/plugins/postgres_jdbc/connectionResolver.tdr. The
  required-attributes list must exactly match connectionFields.xml's
  field `name`s plus any implicit fields the dialog always provides.
-->
<tdr class='iris_jdbc'>
	<connection-resolver>
    <connection-builder>
      <script file='connectionBuilder.js'/>
    </connection-builder>
    <connection-normalizer>
      <required-attributes>
        <attribute-list>
          <attr>server</attr>
          <attr>port</attr>
          <attr>dbname</attr>
          <attr>authentication</attr>
          <attr>username</attr>
          <attr>password</attr>
          <attr>ssl</attr>
        </attribute-list>
      </required-attributes>
    </connection-normalizer>
    <connection-properties>
      <script file='connectionProperties.js'/>
    </connection-properties>
	</connection-resolver>
</tdr>
